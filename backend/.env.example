# CLEF — variables d'environnement du backend
#
# ⚠️ CE FICHIER EST LA RÉFÉRENCE, et il est VÉRIFIÉ : `tests/test_env_example.py`
# compare cette liste à ce que le code lit réellement (os.getenv + champs
# pydantic-settings) et fait échouer la suite au moindre écart, dans les deux sens.
# Une variable ajoutée au code sans l'être ici — ou l'inverse — se voit.
#
# Reconstruit le 2026-08-28 DEPUIS LE CODE. Les trois anciennes sources se
# contredisaient : `.env` portait 18 clés que rien ne lit (dont 5 `VALKEY_*`,
# vestiges du Memorystore détruit le 2026-08-26), `.env.example` en annonçait 4 que
# seul `validate_env.py` connaît, et `validate_env.py` est lui-même périmé.
#
# ⚠️ Portée : ce fichier ne sert qu'au DÉVELOPPEMENT LOCAL (et à
# `./run_local.sh --real`). Sur Cloud Run, rien n'est lu ici : les variables sont
# injectées par `deploy/cloudrun-api.yaml.tpl`, et les trois secrets viennent de
# Secret Manager. Une valeur fausse ici ne casse donc que le poste local.
#
# Copier en `.env.local` — la configuration de CE POSTE — et renseigner les lignes
# marquées « ← À RENSEIGNER ». Les `.env.dev` / `.env.test` / `.env.prod` décrivent
# les cibles de déploiement, pas le poste de travail.

# ─── Mode d'exécution ─────────────────────────────────────────────────────────
# USE_MOCKS=true remplace Google (Sheets/Drive/Gmail/Calendar) et l'OIDC par des
# doubles en mémoire : aucune credential, aucun appel réseau. C'est le mode par
# défaut du développement.
# ⚠️ En production, `true` désactiverait l'authentification — voir constat S1.
USE_MOCKS=true
ENV=local
# ENVIRONMENT sert au nom du keyring KMS (`clef-<environment>-keyring`) ; ENV n'est
# qu'un libellé. Deux variables pour une même notion : héritage, à unifier un jour.
ENVIRONMENT=local
DEFAULT_DT=DT75
# La documentation interactive (/docs) est FERMÉE par défaut : elle décrit toute la
# surface d'API, authentification comprise.
ENABLE_API_DOCS=true
# Tâches de fond APScheduler (alertes CT et antipollution, rappels de devis).
SCHEDULER_ENABLED=true

# ─── Datastore ────────────────────────────────────────────────────────────────
# Redis 8 avec les modules JSON et Search. `docker compose up -d redis` le fournit.
REDIS_URL=redis://localhost:6379/0

# ─── OAuth Google ─────────────────────────────────────────────────────────────
# Les deux valeurs sont DANS le fichier de credentials téléchargé depuis la console
# (champs `.web.client_id` et `.web.client_secret`), jamais dans son nom de fichier.
GOOGLE_CLIENT_ID=                    # ← À RENSEIGNER  <numéro>-<empreinte>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=                # ← À RENSEIGNER  GOCSPX-…
# Les deux URI doivent être déclarés à l'identique sur le client OAuth en console.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
# Second flux : délégation Calendar/Drive/Gmail d'un gestionnaire DT
# (`/auth/authorize-dt`). Vide, il dérive de BACKEND_URL — ce qui convient en local.
DT_OAUTH_REDIRECT_URI=
# Listes séparées par des virgules (pas du JSON).
GOOGLE_SCOPES=openid,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile
DT_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/gmail.send
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URI=https://www.googleapis.com/oauth2/v3/userinfo
# Seul ce domaine peut s'authentifier.
ALLOWED_EMAIL_DOMAIN=@croix-rouge.fr

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=clef_session
# `false` en local (HTTP clair), `true` partout où l'on sert en HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE=86400
# ⚠️ Cette variable ne signe RIEN : le cookie porte l'id_token de Google, vérifié
# contre les clés publiques de Google. Elle est lue par la configuration et utilisée
# nulle part — conservée le temps de trancher son retrait, pas un secret à protéger.
SESSION_SECRET_KEY=dev-secret-key-change-in-production

# ─── URL et origines ──────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200
# ALLOWED_FRONTEND_URLS est une LISTE : destinations autorisées après connexion.
ALLOWED_FRONTEND_URLS=http://localhost:4200,http://localhost:4202
CORS_ORIGINS=http://localhost:4200,http://localhost:4202,http://localhost:8000
# ⚠️ DOMAIN est l'hôte encodé dans les QR codes IMPRIMÉS et collés sur les véhicules.
DOMAIN=localhost:4202

# ─── Comptes et périmètres ────────────────────────────────────────────────────
# Le seul compte dont l'authentification ne consulte pas le référentiel Redis :
# l'unique porte d'entrée avant la première synchronisation.
EMAIL_GESTIONNAIRE_DT=               # ← À RENSEIGNER  prenom.nom@croix-rouge.fr
# Super admin : sans ces trois valeurs, `user_is_super_admin` est toujours faux et
# les routes /admin/super/* sont inaccessibles à quiconque. C'est l'état actuel de
# dev — les renseigner est une décision, pas une formalité.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_DT_ID=
SUPER_ADMIN_DT_NUMERIC_ID=

# ─── Google Workspace ─────────────────────────────────────────────────────────
# ⚠️ NE PAS CHERCHER À LES RENSEIGNER — elles sont un VESTIGE.
#
# Le flux de données va dans l'autre sens : Apps Script POUSSE les bénévoles vers
# l'API et TIRE les véhicules depuis l'API. Le backend n'écrit ni ne lit ces
# classeurs, et il ne peut pas les lire : le domaine @croix-rouge.fr interdit de
# partager un document vers une adresse .gserviceaccount.com (constat N13).
#
# Leurs seuls lecteurs restants :
#   VEHICULES_SPREADSHEET_ID     alert_service.py:100, upload.py:55,
#                                reservations.py:56 — les trois routes de N13,
#                                à réécrire vers Redis ;
#   BENEVOLES_SPREADSHEET_ID     main.py:72, amorçage appelé uniquement si USE_MOCKS ;
#   RESPONSABLES_SPREADSHEET_ID  aucun appelant.
#
# `./run_local.sh --real` se contente d'un AVERTISSEMENT si elles manquent.
# Elles disparaîtront avec N13.
VEHICULES_SPREADSHEET_ID=
BENEVOLES_SPREADSHEET_ID=
RESPONSABLES_SPREADSHEET_ID=
# Adresse du service account, utilisée comme expéditeur par le service Gmail réel.
SERVICE_ACCOUNT_EMAIL=
# ⚠️ Chemin d'une clé de service account, pour le mode réel LOCAL uniquement.
# Sur Cloud Run cette variable doit rester ABSENTE : l'identité vient des
# Application Default Credentials, et `tests/test_cloudrun_template.py` interdit son
# injection.
GOOGLE_APPLICATION_CREDENTIALS=

# ─── GCP ──────────────────────────────────────────────────────────────────────
# KMS chiffre les refresh tokens OAuth des gestionnaires DT. Il lit GCP_PROJECT_ID,
# et retombe sur GCP_PROJECT — c'est cette seconde que Cloud Run injecte.
GCP_PROJECT=
GCP_PROJECT_ID=
# ⚠️ europe-west9, différente de la région de Cloud Run : le keyring existe déjà là,
# et un keyring KMS ne se déplace pas (voir variables.tf).
GCP_REGION=europe-west9

# ─── QR codes ─────────────────────────────────────────────────────────────────
# ⚠️ 16 caractères minimum (le code refuse en dessous), 32+ recommandés. NE JAMAIS
# LE CHANGER une fois des QR codes imprimés : les autocollants deviendraient
# invalides. `openssl rand -hex 32`.
QR_CODE_SALT=                        # ← À RENSEIGNER

# ─── Alertes ──────────────────────────────────────────────────────────────────
# Contrôle technique et antipollution expirant dans moins de N jours.
ALERT_DELAY_DAYS=60
ALERT_CRON_HOUR=8
ALERT_CRON_MINUTE=0
# ⚠️ Le DESTINATAIRE des alertes n'est PAS ici : c'est un réglage métier, stocké dans
# Redis et modifiable par un gestionnaire DT depuis l'écran de configuration. La
# variable d'environnement a été retirée le 2026-08-28 — elle écrasait silencieusement
# le choix fait dans l'application.

# ─── Synchronisation du référentiel ───────────────────────────────────────────
# Garde-fou : une synchronisation désactivant plus de 20 % des bénévoles est refusée.
SYNC_MAX_DEACTIVATION_RATIO=0.2
